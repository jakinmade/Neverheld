{
  "name": "@neverheld/browser-kit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser-side network enforcement and offline-verifiable session evidence.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build-kit.mjs",
    "build:check": "npm run build && node scripts/check-build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build:check && npm run test:browser",
    "render:proof": "tsx scripts/render-proof.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "jszip": "3.10.1",
    "qrcode-generator": "2.0.4"
  }
}
